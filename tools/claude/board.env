# Параметры доски GitHub Projects v2 проекта Matio.
# Читается tools/claude/board_status.sh. Секретов здесь нет — это публичные
# идентификаторы объектов GitHub, поэтому файл КОММИТИТСЯ: gitignored-файлы не
# приезжают в worktree, а скрипт доски нужен каждому агенту.
#
# Доска: https://github.com/users/efymd9/projects/1
# Заполнено на этапе 01 плейбука (docs/mega-process/01-github-foundation.md).
#
# ГРАБЛЯ: любой updateProjectV2Field пересоздаёт ID ВСЕХ опций поля Status.
# Меняешь набор колонок → снимок всей доски ДО, восстановление статусов ПОСЛЕ,
# новые ID сюда. Добыть ID заново:
#   gh api graphql -f query='query{ user(login:"efymd9"){ projectV2(number:1){
#     id fields(first:20){ nodes{ ... on ProjectV2SingleSelectField{
#       id name options{ id name } } } } } }'

BOARD_OWNER=efymd9
BOARD_NUMBER=1

PROJECT_ID=PVT_kwHOD4kAes4Be_H9
FIELD_ID=PVTSSF_lAHOD4kAes4Be_H9zhZVWI8

OPT_BACKLOG=1b22858d   # Продуктовый бэклог
OPT_TECH=fe58a46f      # Технический бэклог
OPT_SPEC=554ed691      # Spec ready
OPT_PROGRESS=c4b59798  # In progress
OPT_REVIEW=de994062    # In review
OPT_DONE=a5258ab2      # Done
