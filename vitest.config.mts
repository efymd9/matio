import path from "node:path";
import { fileURLToPath } from "node:url";

import { storybookTest } from "@storybook/addon-vitest/vitest-plugin";
import { playwright } from "@vitest/browser-playwright";
import { defineConfig } from "vitest/config";

const dirname = path.dirname(fileURLToPath(import.meta.url));

// Test runner for the web half of the product (`mobile/` has its own toolchain
// and is excluded everywhere here). Two projects:
//
//   unit      — pure logic in node. Fast, no DOM, no network. This is where
//               `lib/` lives and where most tests belong.
//   storybook — every story in the UI Lab is also a test: it must render in a
//               real browser (Playwright/chromium) without throwing and its
//               play function must pass. The gallery IS the suite.
//
// Coverage feeds two gates in CI (.github/workflows/ci.yml):
//   1. the ratchet — thresholds below may only ever go UP (see CLAUDE.md);
//   2. diff-cover — lines CHANGED by a PR must be ≥85% covered, which is the
//      gate that actually bites. Cobertura output exists for it.
export default defineConfig({
  // `@/…` imports resolve from tsconfig paths — Vite reads them natively.
  resolve: { tsconfigPaths: true },
  test: {
    coverage: {
      provider: "v8",
      reporter: ["text-summary", "lcov", "cobertura"],
      reportsDirectory: "coverage",

      // Everything that ships to users is measured, tested or not — a coverage
      // number computed only over files that happen to have tests flatters
      // itself and makes the ratchet meaningless.
      //
      // Source extensions only: `app/` also holds css, fonts and images, and
      // the v8 provider tries to parse whatever it is handed.
      include: [
        "app/**/*.{ts,tsx}",
        "components/**/*.{ts,tsx}",
        "db/**/*.ts",
        "lib/**/*.{ts,tsx}",
        "proxy.ts",
      ],

      exclude: [
        // Not application code.
        "**/*.d.ts",
        "**/*.test.{ts,tsx}",
        // Stories are the bench, not shipped behaviour: they are the
        // instrument that measures components, so measuring them too would be
        // circular.
        "**/*.stories.tsx",
        // Generated by Drizzle from the schema — never hand-edited, so a test
        // over it would assert the generator, not our behaviour.
        "drizzle/**",
        // One-shot operational scripts (promote-to-admin, stripe-setup,
        // seeds). They talk to live vendors by design; a unit test around them
        // would be theatre. Run manually, verified by their own output.
        "scripts/**",
        // The Expo app: separate project, separate toolchain, separate lint.
        "mobile/**",
        // Loose design references, not part of any bundle.
        "design_handoff_matio_redesign/**",
      ],

      // RATCHET — these numbers move in one direction only. Raised coverage in
      // a PR? Raise the floor in the SAME PR. Lowering one is a review blocker.
      //
      // Re-measured after the UI Lab landed — stories render real components in
      // a browser, so component coverage rose on its own (statements
      // 1.10 → 1.37, lines 1.04 → 1.33, functions 0.65 → 0.92, branches
      // 1.21 → 1.64). Floors follow, rounded down.
      thresholds: {
        lines: 1.3,
        functions: 0.9,
        branches: 1.6,
        statements: 1.3,
      },
    },

    projects: [
      {
        extends: true,
        test: {
          name: "unit",
          environment: "node",
          include: [
            "{app,components,db,lib,tools}/**/*.{test,spec}.{ts,tsx}",
            "proxy.test.ts",
          ],
        },
      },
      {
        extends: true,
        plugins: [
          storybookTest({ configDir: path.join(dirname, ".storybook") }),
        ],
        test: {
          name: "storybook",
          browser: {
            enabled: true,
            headless: true,
            provider: playwright({}),
            instances: [{ browser: "chromium" }],
            expect: {
              toMatchScreenshot: {
                // Antialiasing noise is not a regression. 2% of pixels is
                // wide enough to survive a GPU/driver hiccup and narrow
                // enough to catch a shifted button or a changed colour.
                comparatorName: "pixelmatch",
                comparatorOptions: { allowedMismatchedPixelRatio: 0.02 },
              },
            },
          },
        },
      },
    ],
  },
});
