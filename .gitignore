# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# Nested installs too (mobile/ has its own npm). The root pattern above is
# anchored, and mobile/.gitignore only exists on the feat/mobile-app branch —
# so on any main-based branch a plain `git add -A` would otherwise stage
# ~62k files out of mobile/node_modules and mobile/.expo. Measured, not feared.
node_modules/
.expo/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# clerk configuration (can include secrets)
/.clerk/

*storybook.log
storybook-static

# Visual baselines: only the LINUX ones are committed — CI is the arbiter.
# A macOS run writes its own *-darwin.png (different text rasterisation);
# committing those would make the suite red for everyone else.
**/__screenshots__/**/*-darwin.png
.vitest-attachments/
